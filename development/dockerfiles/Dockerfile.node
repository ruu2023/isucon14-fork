FROM node:22.11

WORKDIR /home/isucon/webapp/nodejs

RUN apt-get update && apt-get install --no-install-recommends -y \
  default-mysql-client-core=1.1.0 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --no-audit
COPY . .

CMD ["npm", "run", "start"]
